<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="320.0" prefWidth="360.0" spacing="10.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.AddFournisseurController"
>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label fx:id="labelTitre" style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Nouveau fournisseur" />

        <Label text="Nom" />
        <TextField fx:id="champNom" />

        <Label text="Email" />
        <TextField fx:id="champEmail" />

        <Label text="Téléphone" />
        <TextField fx:id="champTel" />

        <Label fx:id="labelErreur" style="-fx-text-fill: red;" visible="false" wrapText="true" />

        <HBox spacing="10.0">
            <children>
                <Button onAction="#handleEnregistrer" styleClass="btn-primaire" text="Enregistrer" />
                <Button onAction="#handleAnnuler" text="Annuler" />
            </children>
        </HBox>
    </children>
</VBox>