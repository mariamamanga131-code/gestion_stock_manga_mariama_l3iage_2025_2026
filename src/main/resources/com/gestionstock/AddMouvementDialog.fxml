<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="420.0" prefWidth="380.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.AddMouvementController"
>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Nouveau mouvement de stock" />

        <Label text="Produit" />
        <ComboBox fx:id="comboProduit" onAction="#mettreAJourApercu" prefWidth="320.0" />

        <Label text="Type de mouvement" />
        <HBox spacing="20.0">
            <children>
                <RadioButton fx:id="radioEntree" onAction="#mettreAJourApercu" text="Entrée">
                    <toggleGroup>
                        <ToggleGroup fx:id="groupeType" />
                    </toggleGroup>
                </RadioButton>
                <RadioButton fx:id="radioSortie" onAction="#mettreAJourApercu" text="Sortie" toggleGroup="$groupeType" />
            </children>
        </HBox>

        <Label text="Quantité" />
        <TextField fx:id="champQuantite" onKeyReleased="#mettreAJourApercu" />

        <Label text="Motif (obligatoire pour une sortie)" />
        <TextField fx:id="champMotif" />

        <Label fx:id="labelApercu" style="-fx-font-weight: bold;" />

        <Label fx:id="labelErreur" style="-fx-text-fill: red;" visible="false" wrapText="true" />

        <HBox spacing="10.0">
            <children>
                <Button onAction="#handleEnregistrer" styleClass="btn-primaire" text="Enregistrer" />
                <Button onAction="#handleAnnuler" text="Annuler" />
            </children>
        </HBox>
    </children>
</VBox>