<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="600.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.CategorieController"
>
    <children>
        <HBox prefHeight="100.0" prefWidth="200.0" spacing="10.0">
            <children>
                <TextField fx:id="champRecherche" onKeyReleased="#rechercherCategories" prefWidth="300.0" promptText="Recherche" />
                <Button mnemonicParsing="false" prefWidth="90.0" styleClass="btn-primaire" text="Ajouter" fx:id="btnAjouter" onAction="#handleAjouter" />
                <Button fx:id="boutonModifier" mnemonicParsing="false" onAction="#handleModifier" prefWidth="90.0" text="Modifier" />
                <Button fx:id="boutonSupprimer" mnemonicParsing="false" onAction="#supprimerCategorie" prefWidth="90.0" text="Supprimer" />
            </children>
        </HBox>
        <TableView fx:id="tableCategories" prefWidth="640.0">
            <columns>
                <TableColumn fx:id="colonneNom" prefWidth="200.0" text="Nom" />
                <TableColumn fx:id="colonneDescription" prefWidth="280.0" text="Description" />
                <TableColumn fx:id="colonneNbProduits" prefWidth="150.0" text="Nb. produits" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>