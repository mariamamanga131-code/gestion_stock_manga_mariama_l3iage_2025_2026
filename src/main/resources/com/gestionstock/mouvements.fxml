<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="560.0" prefWidth="700.0" spacing="15.0"
      xmlns="http://javafx.com/javafx/26"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.gestionstock.controller.MouvementController"
>
    <children>
        <HBox spacing="10.0">
            <children>
                <ComboBox fx:id="comboType" onAction="#appliquerFiltres" prefWidth="150.0" promptText="Type" />
                <DatePicker fx:id="dateDebut" onAction="#appliquerFiltres" promptText="Date début" />
                <DatePicker fx:id="dateFin" onAction="#appliquerFiltres" promptText="Date fin" />
                <Button mnemonicParsing="false" prefWidth="150.0" styleClass="btn-primaire" text="+ Nouveau Mouvement" fx:id="btnAjouter" onAction="#handleAjouter" />
            </children>
        </HBox>
        <TableView fx:id="tableMouvements" prefWidth="740.0">
            <columns>
                <TableColumn fx:id="colonneDate" prefWidth="150.0" text="Date" />
                <TableColumn fx:id="colonneProduit" prefWidth="180.0" text="Produit" />
                <TableColumn fx:id="colonneType" prefWidth="90.0" text="Type" />
                <TableColumn fx:id="colonneQuantite" prefWidth="90.0" text="Quantité" />
                <TableColumn fx:id="colonneMotif" prefWidth="200.0" text="Motif" />
                <TableColumn fx:id="colonneUtilisateur" prefWidth="140.0" text="Utilisateur" />
            </columns>
        </TableView>
    </children>
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>